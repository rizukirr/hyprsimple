* {
    background:     {{ background }}FF;
    background-tr:  {{ background }}DF;
    background-alt: {{ surface }}FF;
    foreground:     {{ foreground }}FF;
    selected:       {{ ui_accent }}FF;
    active:         {{ ui_success }}FF;
    urgent:         {{ ui_danger }}FF;
    muted:          {{ ui_muted }}FF;
}
