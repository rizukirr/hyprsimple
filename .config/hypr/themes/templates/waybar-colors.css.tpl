@define-color fg {{ foreground }};
@define-color bg-widget {{ surface }};
@define-color bg-deep {{ background }};
@define-color accent {{ ui_accent }};
@define-color accent-bright {{ ui_info }};
@define-color accent-dim {{ ui_accent_dim }};
@define-color secondary {{ ui_secondary }};
@define-color success {{ ui_success }};
@define-color warning {{ ui_warning }};
@define-color danger {{ ui_danger }};
@define-color info {{ ui_info }};
@define-color muted {{ ui_muted }};
