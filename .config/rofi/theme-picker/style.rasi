/*****----- Global Properties -----*****/
/* rofi-colors.rasi is a symlink the theme switcher repoints on every theme
   change, so this picker repaints itself with the rest of the desktop. */
@import                          "rofi-colors.rasi"

/*****----- Main Window -----*****/
window {
    /* transparency "real" gives the surface an alpha channel. Without it the
       alpha byte in @background-tr is ignored and the panel renders solid. */
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    width:                       1240px;
    padding:                     16px;
    border:                      2px;
    border-radius:               16px;
    border-color:                @selected;
    background-color:            @background-tr;
}

/*****----- Mainbox -----*****/
/* -theme replaces rofi's base theme outright, so any element left unset falls
   back to rofi's built-in light defaults. Without this the grid sits on white. */
mainbox {
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    padding:                     6px 10px;
    margin:                      0px 0px 12px 0px;
    background-color:            transparent;
    border:                      0px 0px 2px 0px;
    border-color:                @background-alt;
    children:                    [ "prompt", "entry" ];
}

prompt {
    padding:                     0px 8px 0px 0px;
    background-color:            transparent;
    text-color:                  @selected;
}

entry {
    placeholder:                 "Filter";
    placeholder-color:           @background-alt;
    background-color:            transparent;
    text-color:                  @foreground;
}

/*****----- Listview -----*****/
listview {
    columns:                     3;
    /* rofi lays elements out column-major by default, so an alphabetical list
       reads downwards, not across. horizontal makes the cursor move left to
       right along each row, which is what a grid implies. */
    flow:                        horizontal;
    lines:                       2;
    spacing:                     14px;
    cycle:                       true;
    scrollbar:                   false;
    background-color:            transparent;
}

/*****----- Elements -----*****/
element {
    orientation:                 vertical;
    padding:                     6px;
    border-radius:               12px;
    background-color:            transparent;
    text-color:                  @foreground;
}

element selected {
    background-color:            @background-alt;
    text-color:                  @foreground;
}

/* element-icon takes a single square size. width and height are accepted by the
   parser and then ignored, so a 3:2 photo letterboxes inside this box. */
element-icon {
    size:                        370px;
    background-color:            transparent;
}

/* The square icon box letterboxes a 16:9 photo, leaving roughly 110px empty
   above and below it. A negative top margin pulls the caption back up against
   the photo instead of leaving it stranded at the bottom of the box. */
element-text {
    horizontal-align:            0.5;

    padding:                     4px 4px 2px 4px;
    background-color:            transparent;
    text-color:                  inherit;
}
