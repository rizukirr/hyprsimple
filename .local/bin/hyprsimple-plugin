#!/bin/bash
# Manage trusted external repositories. Manifest data is never evaluated.
set -euo pipefail

fail() { printf 'hyprsimple-plugin: %s\n' "$*" >&2; exit 1; }
ROOT="${HYPRSIMPLE_PLUGIN_ROOT:-$HOME/.local/share/hyprsimple-plugins}"
CONFIG="$HOME/.config/hyprsimple/plugins.json"
STATE="$HOME/.local/state/hyprsimple/plugins"
STAGE=''
TEMP=''
TRANSACTION=false
cleanup() {
  local status=$? retained=false
  trap - EXIT
  set +e
  if [[ $TRANSACTION == true && $status != 0 ]]; then
    printf 'hyprsimple-plugin: update interrupted, restoring previous installation\n' >&2
    if [[ -d $STAGE/old ]]; then
      [[ ! -d $dir ]] || lifecycle "$dir" disable || printf 'hyprsimple-plugin: candidate rollback failed\n' >&2
      rm -rf -- "$dir"
      if ! mv -- "$STAGE/old" "$dir"; then
        printf 'hyprsimple-plugin: code rollback failed, previous code retained at %s/old\n' "$STAGE" >&2
        retained=true
      fi
    fi
    if [[ -f $STAGE/config ]]; then
      TEMP=$(mktemp "$(dirname "$CONFIG")/.plugins.XXXXXX")
      if ! cp -- "$STAGE/config" "$TEMP" || ! mv -f -- "$TEMP" "$CONFIG"; then
        printf 'hyprsimple-plugin: config rollback failed, backup retained at %s/config\n' "$STAGE" >&2
        retained=true
      fi
    fi
    config=$old_config
    bindings || printf 'hyprsimple-plugin: bindings rollback failed\n' >&2
    if [[ $enabled == true ]]; then
      lifecycle "$dir" enable || printf 'hyprsimple-plugin: lifecycle rollback failed\n' >&2
    fi
  fi
  [[ -z $STAGE || $retained == true ]] || rm -rf -- "$STAGE"
  [[ -z $TEMP ]] || rm -f -- "$TEMP"
  exit "$status"
}
trap cleanup EXIT

unique_json() {
  jq -s -e 'length == 1' "$1" >/dev/null || return 1
  jq --stream -s -e '[.[] | select(length == 2) | .[0]] | length == (unique | length)' "$1" >/dev/null
}
valid_id() { [[ $1 =~ ^[a-z][a-z0-9]*([.-][a-z0-9]+)*$ && $1 != hyprsimple.* ]]; }
read_config() {
  if [[ -e $CONFIG || -L $CONFIG ]]; then
    [[ -f $CONFIG && ! -L $CONFIG ]] || fail 'config must be a regular file'
    unique_json "$CONFIG" || fail 'duplicate config fields or IDs'
    config=$(cat "$CONFIG")
  else
    config='{"schemaVersion":1,"plugins":{}}'
  fi
  jq -e '
    def id: type == "string" and test("^[a-z][a-z0-9]*([.-][a-z0-9]+)*$") and (startswith("hyprsimple.") | not);
    def placement: . == "left" or . == "center" or . == "right";
    type == "object" and (keys == ["plugins","schemaVersion"]) and .schemaVersion == 1 and
    (.plugins | type == "object" and all(to_entries[];
      (.key | id) and (.value | type == "object" and keys == ["commit","enabled","placement","settings"] and
        (.enabled | type == "boolean") and (.placement | placement) and (.settings | type == "object") and
        (.commit | type == "string" and test("^([0-9a-f]{40}|[0-9a-f]{64})?$")))))
  ' <<<"$config" >/dev/null || fail 'invalid plugin config'
}
validate_repo() {
  local dir=$1 expected=${2:-} manifest path resolved base
  [[ -d $dir && ! -L $dir ]] || fail "invalid plugin directory: $dir"
  manifest="$dir/manifest.json"
  [[ -f $manifest && ! -L $manifest ]] || fail "manifest must be a regular file: $manifest"
  unique_json "$manifest" || fail 'duplicate manifest fields'
  jq -e '
    def fields($allowed): type == "object" and ((keys - $allowed) | length == 0);
    def text: type == "string" and length > 0 and (test("[\u0000-\u001f\u007f]") | not);
    def path: text and (startswith("/") | not) and (split("/") | all(. != ".." and . != "." and . != ""));
    def placement: . == "left" or . == "center" or . == "right";
    def packages: type == "array" and all(.[]; type == "string" and test("^[a-z0-9][a-z0-9@._+-]*$")) and length == (unique | length);
    fields(["schemaVersion","apiVersion","id","name","version","entryPoints","placement","dependencies","lifecycle","bindings","panelAliases"]) and
    .schemaVersion == 1 and .apiVersion == 1 and
    (.id | text and test("^[a-z][a-z0-9]*([.-][a-z0-9]+)*$") and (startswith("hyprsimple.") | not)) and
    (.name | text) and (.version | text) and
    (.entryPoints | fields(["service","widget","panel"]) and length > 0 and all(.[]; path and endswith(".qml"))) and
    ((has("placement") | not) or (.placement | placement)) and
    ((has("dependencies") | not) or (.dependencies | fields(["packages","aur"]) and all(.[]; packages))) and
    ((has("lifecycle") | not) or (.lifecycle | fields(["enable","disable"]) and all(.[]; path))) and
    ((has("bindings") | not) or (.bindings | type == "array" and all(.[];
      fields(["key","description","action"]) and keys == ["action","description","key"] and
      (.key | text) and (.description | text) and .action == "toggle-panel"))) and
    ((has("panelAliases") | not) or (.panelAliases | type == "array" and all(.[]; text and test("^[a-z][a-z0-9-]*$")) and length == (unique | length))) and
    (((.bindings // [] | length) == 0 and (.panelAliases // [] | length) == 0) or .entryPoints.panel != null)
  ' "$manifest" >/dev/null || fail "invalid manifest: $manifest"
  candidate_id=$(jq -r .id "$manifest")
  [[ -z $expected || $candidate_id == "$expected" ]] || fail "manifest ID differs from directory: $expected"
  base=$(realpath -e -- "$dir")
  while IFS= read -r path; do
    resolved=$(realpath -e -- "$dir/$path") || fail "missing plugin path: $path"
    [[ $resolved == "$base/"* && -f $resolved ]] || fail "escaping or invalid plugin path: $path"
  done < <(jq -r '(.entryPoints // {}), (.lifecycle // {}) | .[]' "$manifest")
}
validate_registry() {
  local dir aliases='[]' next
  for dir in "$ROOT"/*; do
    [[ -e $dir || -L $dir ]] || continue
    validate_repo "$dir" "$(basename "$dir")"
    next=$(jq -c '.panelAliases // []' "$dir/manifest.json")
    aliases=$(jq -cn --argjson a "$aliases" --argjson b "$next" '$a + $b')
  done
  while IFS= read -r configured_id; do
    [[ -d $ROOT/$configured_id ]] || fail "enabled plugin is missing: $configured_id"
  done < <(jq -r '.plugins | to_entries[] | select(.value.enabled) | .key' <<<"$config")
  jq -e 'length == (unique | length)' <<<"$aliases" >/dev/null || fail 'duplicate panel aliases'
}
validate_candidate() {
  local dir=$1 expected=${2:-} other aliases
  validate_repo "$dir" "$expected"
  aliases=$(jq -c '.panelAliases // []' "$dir/manifest.json")
  for other in "$ROOT"/*; do
    [[ -e $other || -L $other ]] || continue
    [[ $(basename "$other") == "$expected" ]] && continue
    [[ $(basename "$other") != "$candidate_id" ]] || fail 'plugin ID already installed'
    jq -e --argjson a "$aliases" '((.panelAliases // []) - $a) == (.panelAliases // [])' "$other/manifest.json" >/dev/null || fail 'duplicate panel aliases'
  done
}
write_config() {
  mkdir -p "$(dirname "$CONFIG")"
  TEMP=$(mktemp "$(dirname "$CONFIG")/.plugins.XXXXXX")
  printf '%s\n' "$config" >"$TEMP"
  chmod 600 "$TEMP"
  mv -f -- "$TEMP" "$CONFIG"
  TEMP=''
}
bindings() {
  local id result='[]' items
  while IFS= read -r id; do
    [[ -d $ROOT/$id ]] || continue
    items=$(jq -c --arg id "$id" '[.bindings // [] | .[] | . + {pluginId:$id}]' "$ROOT/$id/manifest.json")
    result=$(jq -cn --argjson a "$result" --argjson b "$items" '$a + $b')
  done < <(jq -r '.plugins | to_entries[] | select(.value.enabled) | .key' <<<"$config")
  TEMP=$(mktemp "$STATE/.bindings.XXXXXX")
  jq -n --argjson bindings "$result" '{schemaVersion:1,bindings:$bindings}' >"$TEMP"
  mv -f -- "$TEMP" "$STATE/bindings.json"
  TEMP=''
}
refresh() {
  "$HOME/.local/bin/hyprsimple-restart-bar.sh" --if-running || fail 'operation completed, but bar refresh failed'
  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    hyprctl reload >/dev/null || fail 'operation completed, but Hyprland reload failed'
  fi
}
lifecycle() {
  local dir=$1 action=$2 script
  script=$(jq -r --arg action "$action" '.lifecycle[$action] // empty' "$dir/manifest.json")
  [[ -n $script ]] || return 0
  (cd "$dir" && HYPRSIMPLE_PLUGIN_ID="$(jq -r .id manifest.json)" bash -- "$script" 9>&-)
}
dependencies() {
  local dir=$1 kind pkg helper
  local -a missing flags
  for kind in packages aur; do
    missing=()
    while IFS= read -r pkg; do
      pacman -Q "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
    done < <(jq -r --arg kind "$kind" '.dependencies[$kind] // [] | .[]' "$dir/manifest.json")
    ((${#missing[@]})) || continue
    if [[ $kind == packages ]]; then
      sudo pacman -S --needed --noconfirm -- "${missing[@]}" || return 1
    else
      # shellcheck source=/dev/null
      source "$(dirname "${BASH_SOURCE[0]}")/hyprsimple-aur-helper.sh" || return 1
      helper=$(aur_helper) || return 1
      mapfile -t flags < <(aur_unattended_flags "$helper")
      "$helper" -S --needed "${flags[@]}" -- "${missing[@]}" || return 1
    fi
    for pkg in "${missing[@]}"; do
      pacman -Q "$pkg" >/dev/null 2>&1 || return 1
    done
  done
}
record() {
  local id=$1 enabled=$2 dir=$3 commit placement
  commit=$(git -C "$dir" rev-parse HEAD)
  placement=$(jq -r '.placement // "left"' "$dir/manifest.json")
  config=$(jq --arg id "$id" --arg commit "$commit" --arg placement "$placement" --argjson enabled "$enabled" '
    .plugins[$id] = {enabled:$enabled,placement:(.plugins[$id].placement // $placement),settings:(.plugins[$id].settings // {}),commit:$commit}' <<<"$config")
  write_config
  bindings
}
acquire() {
  local source=$1 local_mode=$2
  if [[ $local_mode == true ]]; then
    [[ $source != -* && -d $source ]] || fail 'invalid local repository'
    source=$(realpath -e -- "$source")
    git -C "$source" rev-parse --git-dir >/dev/null || fail 'not a local Git repository'
  else
    [[ $source =~ ^(https://github\.com/)?([A-Za-z0-9][A-Za-z0-9_-]*)/([A-Za-z0-9][A-Za-z0-9_.-]*)(\.git)?/?$ ]] || fail 'use OWNER/REPO or an HTTPS GitHub repository URL'
    source="https://github.com/${BASH_REMATCH[2]}/${BASH_REMATCH[3]%.git}.git"
  fi
  STAGE=$(mktemp -d "$(dirname "$ROOT")/.plugin-stage.XXXXXX")
  GIT_TERMINAL_PROMPT=0 git -c protocol.file.allow=always clone --no-local -- "$source" "$STAGE/repo" || fail 'repository acquisition failed'
}

command=${1:-}
shift || true
if [[ $command =~ ^https://github\.com/ || $command =~ ^[A-Za-z0-9][A-Za-z0-9_-]*/[A-Za-z0-9][A-Za-z0-9_.-]*/?$ ]]; then
  set -- "$command" "$@"
  command=install
fi
case "$command" in install|list|validate|enable|disable|update|remove) ;; *) fail 'usage: hyprsimple-plugin {install [--local] SOURCE|list|validate [ID|FOLDER]|enable ID|disable ID|update ID|remove ID}' ;; esac
[[ ! -L $ROOT && ! -L $STATE ]] || fail 'plugin root and state must not be symlinks'
core=$(realpath -m -- "${HYPRSIMPLE_PATH:-$HOME/.local/share/hyprsimple}")
root_path=$(realpath -m -- "$ROOT")
[[ $root_path != "$core" && $root_path != "$core/"* ]] || fail 'plugin storage must be outside the core checkout'
[[ ! -L $STATE/manager.lock ]] || fail 'manager lock must not be a symlink'
mkdir -p "$ROOT" "$STATE"
# A single lock also serializes registry validation with repository replacement.
exec 9>"$STATE/manager.lock"
flock -x 9
read_config
validate_registry
case "$command" in
  list)
    (($# == 0)) || fail 'list takes no arguments'
    for dir in "$ROOT"/*; do
      [[ -d $dir ]] || continue
      id=$(basename "$dir")
      jq -r --argjson config "$config" '[.id,.version,($config.plugins[.id].enabled // false | tostring)] | @tsv' "$dir/manifest.json"
    done
    ;;
  validate)
    (($# <= 1)) || fail 'validate takes at most one ID'
    if (($#)); then
      if [[ -d $1 ]]; then validate_candidate "$(realpath -e -- "$1")" "$(jq -r .id "$1/manifest.json")"
      else valid_id "$1" || fail 'invalid ID'; validate_repo "$ROOT/$1" "$1"; fi
    fi
    printf 'Plugin manifests and config are valid.\n'
    ;;
  install)
    local_mode=false
    if [[ ${1:-} == --local ]]; then local_mode=true; shift; fi
    (($# == 1)) || fail 'install needs one repository'
    acquire "$1" "$local_mode"
    validate_candidate "$STAGE/repo"
    id=$candidate_id
    dependencies "$STAGE/repo" || fail 'dependency installation failed, plugin not installed'
    mv -- "$STAGE/repo" "$ROOT/$id"
    if ! lifecycle "$ROOT/$id" enable; then
      lifecycle "$ROOT/$id" disable || printf 'hyprsimple-plugin: lifecycle rollback failed\n' >&2
      record "$id" false "$ROOT/$id"
      fail 'install activation incomplete, plugin installed disabled, retry enable'
    fi
    record "$id" true "$ROOT/$id"
    refresh
    ;;
  enable|disable|update|remove)
    (($# == 1)) || fail "$command needs one ID"
    id=$1
    valid_id "$id" || fail 'invalid ID'
    dir="$ROOT/$id"
    validate_repo "$dir" "$id"
    enabled=$(jq -r --arg id "$id" '.plugins[$id].enabled // false' <<<"$config")
    case "$command" in
      enable)
        [[ $enabled != true ]] || exit 0
        dependencies "$dir" || fail 'dependency installation failed, plugin remains disabled'
        if ! lifecycle "$dir" enable; then
          lifecycle "$dir" disable || printf 'hyprsimple-plugin: lifecycle rollback failed\n' >&2
          fail 'enable lifecycle failed, enablement not recorded'
        fi
        record "$id" true "$dir"
        ;;
      disable|remove)
        record "$id" false "$dir"
        # Publish disabled UI before stopping background work, including on retries.
        refresh
        lifecycle "$dir" disable || fail 'disable incomplete, retry to stop background work'
        if [[ $command == remove ]]; then rm -rf -- "$dir"; fi
        ;;
      update)
        [[ -z $(git -C "$dir" status --porcelain --untracked-files=all) ]] || fail 'refusing dirty plugin update'
        source=$(git -C "$dir" remote get-url origin)
        local_mode=false
        [[ $source == /* ]] && local_mode=true
        acquire "$source" "$local_mode"
        validate_candidate "$STAGE/repo" "$id"
        dependencies "$STAGE/repo" || fail 'dependency installation failed, old plugin retained'
        old_config=$config
        [[ ! -f $CONFIG ]] || cp -- "$CONFIG" "$STAGE/config"
        TRANSACTION=true
        if [[ $enabled == true ]]; then
          record "$id" false "$dir"
          if ! lifecycle "$dir" disable; then
            fail 'old disable lifecycle failed, update aborted'
          fi
        fi
        mv -- "$dir" "$STAGE/old"
        mv -- "$STAGE/repo" "$dir"
        if [[ $enabled == true ]] && ! lifecycle "$dir" enable; then
          fail 'update activation failed, old code and config restored'
        fi
        record "$id" "$enabled" "$dir"
        TRANSACTION=false
        ;;
    esac
    [[ $command == disable || $command == remove ]] || refresh
    ;;
esac
